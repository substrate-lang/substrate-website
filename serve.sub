;; serve [-l ADDRESS] [-t] [-c HOST] DIR [PORT] serves the site in DIR on ADDRESS (127.0.0.1) and PORT (8000), over TLS
;; with -t, with the certificate and key that substrate run's --tls-cert and --tls-key grant. -c HOST adds HOST and
;; www.HOST to localhost as the names allowed, and www.HOST redirects to HOST. It logs requests to stderr and prints
;; its URL once it listens. Ctrl-C finishes the requests in progress, then exits.
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified "server.sub")

(define w website)
(define names (array string 3))

(define (failed! [problem string])
  (let ([b (make-buffer)])
    (buffer-add-string! (& b) "serve: ")
    (buffer-add-string! (& b) problem)
    (host-exit 1 (buffer-string (& b)))))

(define (listening [s (ptr http-server)])
  (when (== (-> s port) 0) (failed! (error-text (& (-> s problem)))))
  (let ([line (make-buffer)])
    (buffer-add-string! (& line) (if (-> s secure) "https://" "http://"))
    (buffer-add-string! (& line) (if (or (== (-> s host) "") (== (-> s host) "0.0.0.0")) "127.0.0.1" (-> s host)))
    (buffer-add-byte! (& line) 58)
    (http-add-decimal! (& line) (cast i64 (-> s port)))
    (buffer-add-string! (& line) "/\n")
    (host-write 1 (buffer-bytes (& line)))
    (buffer-free! (& line))))

(define (main)
  (let* ([args (host-args)] [n (-> args length)] [at u32 0] [address "127.0.0.1"] [secure #f] [canonical ""]
         [port i64 8000] [ok #t] [count u32 1])
    (while (and ok (< at n) (> (-> (@ args at) length) 0) (== (@ (@ args at) 0) 45))
      (let ([flag (@ args at)])
        (cond [(and (== flag "-l") (< (+ at 1) n)) (set! address (@ args (+ at 1))) (+= at 2)]
              [(== flag "-t") (set! secure #t) (+= at 1)]
              [(and (== flag "-c") (< (+ at 1) n)) (set! canonical (@ args (+ at 1))) (+= at 2)]
              [else (set! ok #f)])))
    (when (== (+ at 2) n) (set! port (http-decimal (@ args (+ at 1)))))
    (when (or (not ok) (< (- n at) 1) (> (- n at) 2) (< port 0) (> port 65535))
      (host-write 2 (cast (slice u8) "usage: serve [-l ADDRESS] [-t] [-c HOST] DIR [PORT]\n"))
      (host-exit 64 ""))
    (set! (@ names 0) ".localhost")
    (when (> (-> canonical length) 0)
      (let ([www (make-buffer)])
        (buffer-add-string! (& www) "www.")
        (buffer-add-string! (& www) canonical)
        (set! (@ names 1) canonical)
        (set! (@ names 2) (buffer-string (& www)))
        (set! count 3)))
    (website-init! (& w) (@ args at) (slice (slice names) 0 count) canonical)
    (set! (-> w server host) address)
    (set! (-> w server secure) secure)
    (set! (-> w server on-done) http-log-access)
    (set! (-> w server listening) listening)
    (http-stop-on-signals! (& (-> w server)) 5000.0 0)
    (let ([why error])
      (unless (http-serve! (& (-> w server)) (cast u32 port) website-handle (& why)) (failed! (error-text (& why)))))))
