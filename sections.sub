;; The site's sections, top to bottom.
(require-unqualified web-ui)
(require-unqualified "code.sub")
(require-unqualified "counter.sub")
(require-unqualified "playground.sub")

(provide site-header hero core-idea examples playground-section faq site-footer)

(define (without-provide [s string]) -> string
  (let ([mark "\n(provide counter)"])
    (for ([i u32 0]) (<= (+ i (-> mark length)) (-> s length)) (+= i 1)
      (when (== (slice s i (+ i (-> mark length))) mark) (return (slice s 0 i))))
    s))

(define (snippet-init [c (ptr code-tokens)] [source string]) (code-tokenize! c source))

(component (snippet [source string])
  #:state [c code-tokens]
  #:init snippet-init
  #:free code-tokens-free!
  (pre ([class "code"]) (code-view c source)))

(define (line-end [s string]) -> u32
  (for ([i u32 0]) (< i (-> s length)) (+= i 1) (when (== (@ s i) 10) (return i)))
  (-> s length))

(view (console [s string])
  (pre ([class "code console"])
    (span ([class "command"]) (text (slice s 0 (line-end s))))
    (text (slice s (line-end s)))))

(view (code-panel [name string] [source string])
  (div ([class "panel"])
    (div ([class "panel-bar"])
      (span ([class "panel-name"]) (text name))
      (span ([class "panel-lang"]) "Substrate"))
    (snippet ([source source]))))

(view (wordmark)
  (a ([class "wordmark"] [href "#top"]) "substrate" (span ([class "cursor"] [aria-hidden "true"]))))

(view (site-header)
  (header ([class "top"])
    (a ([class "skip"] [href "#playground"]) "Skip to playground")
    (div ([class "wrap bar"])
      (wordmark)
      (nav ([aria-label "Site"])
        (a ([href "#why"]) "The Core Idea")
        (a ([href "#playground"]) "Playground")
        (a ([href "https://github.com/substrate-lang/substrate"]) "GitHub ↗")))))

(view (hero)
  (section ([id "top"] [class "hero"])
    (div ([class "wrap hero-grid"])
      (div ([class "hero-copy"])
        (h1 "A Lisp for " (span ([class "accent"]) "WebAssembly"))
        (p ([class "lede"])
          "Substrate has C-like semantics combined with Racket-style hygienic macros for defining new languages and "
          "DSLs. Its compiler is self-hosted, fast, and runs in the browser.")
        (div ([class "actions"])
          (a ([class "button primary"] [href "#playground"]) "Try Substrate")
          (a ([class "button"] [href "#playground/compiler"]) "Compile the compiler!")))
      (figure ([class "hero-code"])
        (code-panel "counter.sub" (without-provide (include-text "counter.sub")))
        (div ([class "live"])
          (span ([class "live-label"]) "live")
          (counter))
        (figcaption
          "This webpage and the server it runs on are written in Substrate using the framework above. "
          (a ([href "https://github.com/substrate-lang/substrate-website"]) "Its source ↗"))))))

(view (core-idea)
  (section ([id "why"] [class "section"])
    (div ([class "wrap"])
      (h2 "Choose your abstractions." (br) "Sandboxed security.")
      (div ([class "features"])
        (article ([class "feature"])
          (p ([class "number"]) "01")
          (h3 "Languages as libraries")
          (p "Hygienic macros and module hooks allow for new languages and DSLs, defined and imported like any "
             "library and sandboxed at compile time.")
          (snippet ([source (include-text "snippets/languages.txt")])))
        (article ([class "feature"])
          (p ([class "number"]) "02")
          (h3 "Flexible memory model")
          (p "Substrate has simple C-like memory management, but languages or DSLs can build their own memory-safe "
             "runtimes.")
          (snippet ([source (include-text "snippets/memory.txt")])))
        (article ([class "feature"])
          (p ([class "number"]) "03")
          (h3 "Reduce supply-chain risk")
          (p "Substrate packages and builds are deterministic and hash-identified. The build system and compiler are "
             "sandboxed with no network access.")
          (console (include-text "snippets/packages.txt")))
        (article ([class "feature"])
          (p ([class "number"]) "04")
          (h3 "Runs on any platform")
          (p "Substrate compiles to Wasm and runs on any platform that supports it, including the web. This website "
             "and the server that serves it are written in Substrate.")
          (snippet ([source (include-text "snippets/web.txt")])))))))

(view (examples)
  (section ([id "examples"] [class "section"])
    (div ([class "wrap"])
      (h2 "Examples")
      (div ([class "cards"])
        (a ([class "card"] [href "https://github.com/substrate-lang/snake-game"])
          (pre ([class "card-art"] [aria-hidden "true"])
            "· · · · · · · · · · ·\n· ■ ■ ■ ■ ■ ▸ · · ● ·\n· ■ · · · · · · · · ·\n· ■ ■ · · · · · · · ·")
          (h3 "Snake")
          (p "The game, written in Substrate.")
          (span ([class "more"]) "Source on GitHub ↗"))
        (a ([class "card"] [href "https://github.com/substrate-lang/web-repl"])
          (pre ([class "card-art"] [aria-hidden "true"])
            "> (define (sq [x i32]) -> i32 (* x x))\n> (sq 7)\n49")
          (h3 "REPL")
          (p "An interactive Substrate REPL.")
          (span ([class "more"]) "Source on GitHub ↗"))))))

(view (playground-section)
  (section ([id "playground"] [class "section"])
    (div ([class "wrap"])
      (h2 "Playground")
      (p ([class "sub"])
        "Edit the program and press Run. It is compiled and run in your browser, in a sandboxed worker beside this "
        "page.")
      (playground))))

(view (faq)
  (section ([id "faq"] [class "section"])
    (div ([class "wrap"])
      (h2 "FAQ")
      (details
        (summary "Why use Substrate over C, Rust, or Zig?")
        (p "Maybe you shouldn't. But consider it if you want a fast, tiny toolchain (especially if you need the "
           "compiler to run in the browser), or powerful compile-time metaprogramming for your domain (e.g. proving a "
           "sort correct with dependent types)."))
      (details
        (summary "Are LLMs good at using Substrate?")
        (p "We haven't done empirical studies, but frontier models understand C-like semantics extremely well and "
           "seem to write small, performant code out of the box. They also understand Racket-style hygienic macros "
           "for building languages. The Bend 2 port was built with LLMs without much difficulty."))
      (details
        (summary "Is Substrate ready for production?")
        (p "Not yet. Substrate is experimental, and the language and its libraries may change before 1.0.")))))

(view (site-footer)
  (footer ([class "foot"])
    (div ([class "wrap bar"])
      (wordmark)
      (a ([href "https://github.com/substrate-lang/substrate"]) "Read the source ↗"))))
