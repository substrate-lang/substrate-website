;; The site's sections, top to bottom.
(require-unqualified web-ui)
(require-unqualified "code.sub")
(require-unqualified "counter.sub")
(require-unqualified "playground.sub")
(require-unqualified snake/snake)
(require-unqualified std/string)

(provide site-header hero core-idea examples playground-section install faq site-footer)

(define (without-provide [s string]) -> string (slice s 0 (string-find s "\n(provide counter)")))

(define (snippet-init [c (ptr code-tokens)] [source string]) (code-tokenize! c source))

(component (snippet [source string])
  #:state [c code-tokens]
  #:init snippet-init
  #:free code-tokens-free!
  (pre ([class "code"]) (code-view c source)))

(view (console [s string])
  (pre ([class "code console"])
    (span ([class "command"]) (text (slice s 0 (string-index s #\newline))))
    (text (slice s (string-index s #\newline)))))

(view (bench-row [name string] [share string] [value string] [ours bool])
  (div ([class (if ours "bench-row ours" "bench-row")] [style share])
    (span ([class "bench-name"]) (text name))
    (span ([class "bench-track"]) (span ([class "bench-bar"])) (span ([class "bench-value"]) (text value)))))

;; Numbers from the substrate repository's benchmarks (bench/)
(view (benchmarks)
  (div ([class "code bench"])
    (div ([class "bench-chart"])
      (p ([class "bench-title"]) "run time, lower is faster")
      (bench-row "Substrate" "--w: 1" "1.43×" #t)
      (bench-row "C -O2 (Wasm)" "--w: 0.70" "1.00×" #f)
      (bench-row "C -O2 (native)" "--w: 0.49" "0.70×" #f))
    (div ([class "bench-chart"])
      (p ([class "bench-title"]) "lines compiled per second")
      (bench-row "Substrate" "--w: 1" "46.5k" #t)
      (bench-row "C -O2" "--w: 0.31" "14.3k" #f))))

(view (code-panel [name string] [source string])
  (div ([class "panel"])
    (div ([class "panel-bar"])
      (span ([class "panel-name"]) (text name))
      (span ([class "panel-lang"]) "Substrate"))
    (snippet ([source source]))))

(view (wordmark)
  (a ([class "wordmark"] [href "#top"])
    (span ([class "mark"] [aria-hidden "true"]) (span ([class "mark-cursor"])))
    "substrate"))

(view (site-header)
  (header ([class "top"])
    (a ([class "skip"] [href "#playground"]) "Skip to playground")
    (div ([class "wrap bar"])
      (wordmark)
      (nav ([aria-label "Site"])
        (a ([class "wide"] [href "#why"]) "The Idea")
        (a ([class "wide"] [href "#examples"]) "Examples")
        (a ([class "wide"] [href "#playground"]) "Playground")
        (a ([href "#install"]) "Install")
        (a ([class "wide"] [href "#faq"]) "FAQ")
        (a ([href "https://github.com/substrate-lang/substrate"]) "GitHub ↗")))))

(view (hero)
  (section ([id "top"] [class "hero"])
    (div ([class "wrap hero-grid"])
      (div ([class "hero-copy"])
        (h1 "A Lisp for " (span ([class "accent"]) "WebAssembly"))
        (p ([class "lede"])
          "Substrate combines the low-level power of C with Racket-style hygienic macros for defining new languages "
          "and DSLs. Its compiler is self-hosted, fast, and runs in the browser.")
        (div ([class "actions"])
          (a ([class "button primary"] [href "#playground"]) "Try Substrate")
          (a ([class "button"] [href "#playground/compiler"]) "Compile the compiler!")))
      (figure ([class "hero-code"])
        (code-panel "counter.sub" (without-provide (include-text "counter.sub")))
        (div ([class "live"])
          (span ([class "live-label"]) "live")
          (counter))
        (figcaption
          "This webpage and the server it runs on are written in Substrate using the framework above. "
          (a ([href "https://github.com/substrate-lang/substrate-website"]) "Its source ↗"))))))

(view (core-idea)
  (section ([id "why"] [class "section"])
    (div ([class "wrap"])
      (h2 "Domain-specific abstractions." (br) "Sandboxed security.")
      (div ([class "features"])
        (article ([class "feature"])
          (p ([class "number"]) "01")
          (h3 "Languages as libraries")
          (p "Hygienic macros and module hooks allow you to use Substrate to define new languages and DSLs as "
             "importable libraries.")
          (snippet ([source (include-text "snippets/languages.txt")])))
        (article ([class "feature"])
          (p ([class "number"]) "02")
          (h3 "Flexible memory model")
          (p "Substrate has simple C-like memory management. Languages or DSLs can build memory-safe runtimes on "
             "top of it.")
          (snippet ([source (include-text "snippets/memory.txt")])))
        (article ([class "feature"])
          (p ([class "number"]) "03")
          (h3 "Run code safely")
          (p "Substrate programs are sandboxed by default and can only access your filesystem and network when and how "
             "you allow them. The build system and compiler are also sandboxed.")
          (console (include-text "snippets/sandbox.txt")))
        (article ([class "feature"])
          (p ([class "number"]) "04")
          (h3 "Fast compilation and execution")
          (p "Substrate compiles code at ~47k lines per second, and its programs run within about 1.4× of C compiled "
             "to Wasm. The compiler builds itself in about a quarter of a second.")
          (benchmarks))))))

(view (examples)
  (section ([id "examples"] [class "section"])
    (div ([class "wrap"])
      (h2 "Examples")
      (div ([class "cards"])
        (div ([class "card game"])
          (snake-game)
          (h3 "Snake")
          (p "The game, written in Substrate.")
          (a ([class "more"] [href "https://github.com/substrate-lang/snake-game"]) "Source on GitHub ↗"))
        (div ([class "card"])
          (h3 "Bend 2")
          (p "A Substrate port of Bend 2, a dependently typed language.")
          (div ([class "links"])
            (a ([class "more"] [href "https://github.com/substrate-lang/substrate-bend2"]) "Source on GitHub ↗")
            (a ([class "more"] [href "https://bend2.dev"]) "Bend 2 ↗")))
        (div ([class "card"])
          (h3 "web-ui")
          (p "A UI library for web programs, written in Substrate.")
          (a ([class "more"] [href "https://github.com/substrate-lang/web-ui"]) "Source on GitHub ↗"))
        (div ([class "card"])
          (h3 "substrate-sqlite")
          (p "SQLite compiled to WebAssembly, with an API in Substrate.")
          (a ([class "more"] [href "https://github.com/substrate-lang/substrate-sqlite"]) "Source on GitHub ↗"))
        (div ([class "card"])
          (div ([class "card-art explorer"] [aria-hidden "true"])
            (pre (span ([class "input"]) "(from orders\n  (group (month date))\n  (select (month date) (sum total)))"))
            (svg ([viewBox "0 0 96 48"])
              (rect ([x 0] [y 30] [width 10] [height 18]))
              (rect ([x 17] [y 22] [width 10] [height 26]))
              (rect ([x 34] [y 26] [width 10] [height 22]))
              (rect ([x 51] [y 14] [width 10] [height 34]))
              (rect ([x 68] [y 18] [width 10] [height 30]))
              (rect ([x 85] [y 4] [width 10] [height 44]))))
          (h3 "SQLite explorer")
          (p "An example app that builds a dashboard using substrate-sqlite, illustrating how native code can be linked "
             "with Substrate.")
          (div ([class "links"])
            (a ([class "more"] [href "sqlite-explorer/"]) "Open the explorer")
            (a ([class "more"] [href "https://github.com/substrate-lang/sqlite-explorer"]) "Source on GitHub ↗")))))))

(view (playground-section)
  (section ([id "playground"] [class "section"])
    (div ([class "wrap"])
      (h2 "Playground")
      (p ([class "sub"])
        "Edit the program and press Run. It is compiled and run in your browser, in a sandboxed worker beside this "
        "page.")
      (playground))))

(view (install)
  (section ([id "install"] [class "section install"])
    (div ([class "wrap"])
      (h2 "Install")
      (div ([class "install-body"])
        (p ([class "sub"])
          "Install Substrate with npm (Wasm runs on V8), or build it from source on "
          (a ([href "https://github.com/substrate-lang/substrate"]) "GitHub") ".")
        (pre ([class "code console"])
          (span ([class "c"]) "# requires Node 22.22.3+ or 24.15+") "\n"
          (span ([class "command"]) "$ npm install -g substrate-lang"))))))

(view (faq)
  (section ([id "faq"] [class "section"])
    (div ([class "wrap"])
      (h2 "FAQ")
      (details
        (summary "Why use Substrate over C, Rust, or Zig?")
        (p "These languages are great and compile to WebAssembly, but Wasm is not their primary target. Substrate "
           "makes the most sense for domains that need a small and fast Wasm-based toolchain that runs anywhere "
           "(including the browser), or powerful compile-time metaprogramming (where macros can build entire "
           "languages). Substrate also provides dedicated tooling for deploying and testing code intended to run in "
           "the browser."))
      (details
        (summary "Are LLMs good at using Substrate?")
        (p "Frontier models are very familiar with C semantics and write performant S-expression-style C with few "
           "errors. They also understand Racket-style hygienic macros for building languages. One "
           (a ([href "https://github.com/substrate-lang/substrate-bend2"]) "dependently typed language")
           " was built with LLMs in more or less a single prompt on Opus 5.5, with further iteration only necessary "
           "to improve compile-time performance and efficiency. It helps that the entire Substrate compiler fits "
           "into the context window of a large model."))
      (details
        (summary "Is Substrate ready for production?")
        (p "Substrate is still evolving and its APIs may change before 1.0. The compiler core is small (<12k LOC) and "
           "has been extensively tested and dogfooded, but other parts of the language and libraries are less "
           "battle-tested."))
      (details
        (summary "Why a language like Substrate now?")
        (p "Substrate is an answer to a broader question: how will programming change in the era of LLMs? We believe "
           "WebAssembly will play an increasingly important role in infrastructure due to the security properties it "
           "provides, and one way to see Substrate is as a meta-language that enables rapid exploration of what is "
           "possible on WebAssembly. Whether the future of programming becomes more oriented towards high-level "
           "verification, or moves closer to the metal, Substrate is a platform that can empower both.")))))

(view (site-footer)
  (footer ([class "foot"])
    (div ([class "wrap bar"])
      (wordmark)
      (a ([href "https://github.com/substrate-lang/substrate"]) "Read the source ↗"))))
