(require-unqualified std/http/test)
(require-unqualified std/http/server)
(require-unqualified "../server.sub")
(require-unqualified std/string)

(define w website)
(define names (array string 3) (array-of string ".localhost" "substrate-lang.com" "www.substrate-lang.com"))
(define t http-test)

(define (got [target string] [host string]) -> i32
  (website-init! (& w) "tests/site" (slice names) "substrate-lang.com")
  (expect (http-test! (& t) (& (-> w server)) "GET" target (slice (array-of string "host" host)) (cast (slice u8) "")))
  (http-test-status (& t)))

(test server-page
  (expect-equal (got "/" "substrate-lang.com") 200)
  (expect-equal (http-test-header (& t) "content-type") "text/html; charset=utf-8")
  (expect-equal (http-test-header (& t) "cache-control") "no-cache")
  (expect-equal (http-test-header (& t) "content-security-policy") website-policy)
  (expect-equal (http-test-header (& t) "x-content-type-options") "nosniff"))

(test server-program
  (expect-equal (got "/0123456789abcdef/program/site.0123456789ab@0+0.wasm" "substrate-lang.com") 200)
  (expect-equal (http-test-header (& t) "content-type") "application/wasm")
  (expect-equal (http-test-header (& t) "cache-control") "public, max-age=31536000, immutable")
  (expect-equal (got "/index.html" "substrate-lang.com") 200)
  (expect-equal (http-test-header (& t) "cache-control") "no-cache"))

(test server-explorer
  (expect-equal (got "/sqlite-explorer/query/?q=(from%20orders)" "substrate-lang.com") 200)
  (expect (string-contains? (cast string (http-test-body (& t))) "<title>explorer</title>"))
  (expect-equal (got "/sqlite-explorer/database/orders/" "substrate-lang.com") 200)
  (expect-equal (got "/sqlite-explorer/nope/" "substrate-lang.com") 404)
  (expect-equal (got "/sqlite-explorer" "substrate-lang.com") 301))

(test server-zipped
  (website-init! (& w) "tests/site" (slice names) "substrate-lang.com")
  (expect (http-test! (& t) (& (-> w server)) "GET" "/0123456789abcdef/host/web/start.mjs"
                      (slice (array-of string "host" "substrate-lang.com" "accept-encoding" "gzip"))
                      (cast (slice u8) "")))
  (expect-equal (http-test-status (& t)) 200)
  (expect-equal (http-test-header (& t) "content-encoding") "gzip")
  (expect-equal (http-test-header (& t) "vary") "accept-encoding")
  (expect-equal (http-test-header (& t) "cache-control") "public, max-age=31536000, immutable"))

(test server-hosts
  (expect-equal (got "/?a=1" "www.substrate-lang.com") 301)
  (expect-equal (http-test-header (& t) "location") "http://substrate-lang.com/?a=1")
  (expect-equal (got "/" "localhost:8000") 200)
  (expect-equal (got "/" "127.0.0.1:8000") 200)
  (expect-equal (got "/" "example.com") 403))

(test server-proxied
  (website-init! (& w) "tests/site" (slice names) "substrate-lang.com")
  (set! (-> w server proxies) 1)
  (expect (http-test! (& t) (& (-> w server)) "GET" "/"
                      (slice (array-of string "host" "www.substrate-lang.com" "x-forwarded-proto" "https"))
                      (cast (slice u8) "")))
  (expect-equal (http-test-status (& t)) 301)
  (expect-equal (http-test-header (& t) "location") "https://substrate-lang.com/"))

(define (rendered [target string]) -> string
  (expect (http-test! (& t) (& (-> w server)) "GET" target (slice (array-of string "host" "substrate-lang.com"))
                      (cast (slice u8) "")))
  (expect-equal (http-test-status (& t)) 200)
  (cast string (http-test-body (& t))))

(test server-rendered
  (website-init! (& w) "tests/site" (slice names) "substrate-lang.com")
  (website-render! (& w))
  (let ([home (rendered "/")])
    (expect-equal (http-test-header (& t) "content-type") "text/html; charset=utf-8")
    (expect-equal (http-test-header (& t) "cache-control") "no-cache")
    (expect (string-contains? home "<style data-ui>"))
    (expect (string-contains? home "Why use Substrate over C, Rust, or Zig?"))
    (expect (string-contains? home "<span data-n class=\"k\"><!--t-->define<!----></span>")))
  (let ([orders (rendered "/sqlite-explorer/database/orders/")])
    (expect (string-contains? orders "<title data-ui=\"explorer\">orders · SQLite explorer</title>"))
    (expect (string-contains? orders "href=\"/sqlite-explorer/database/\"")))
  (expect (string-contains? (rendered "/sqlite-explorer/query/?q=(from%20orders)") "<div id=\"root\"></div>")))
