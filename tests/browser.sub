;; The page and its playground in Chromium, used as a visitor would.
(require-unqualified std/test/browser)
(require-unqualified std/test/test)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified "../server.sub")

(define (finished [b browser]) (expect-missing b (by-css ".pg-state.busy")))

(define (output [b browser] [text string]) (expect-text b (by-css ".pg-output") text))

(define (ran [b browser] [example string] [text string])
  (browser-click! b (by-role "button" example))
  (browser-click! b (by-css ".pg-run"))
  (finished b)
  (output b text))

(define (rewrite [b browser] [program string])
  (browser-click! b (by-css ".pg-input"))
  (browser-press! b "Control+a")
  (browser-type! b (by-css ".pg-input") program))

(define (failed-with [b browser] [text string])
  (finished b)
  (expect-text b (by-css ".pg-state") "Failed")
  (expect-count b (by-text-containing text) 1))

(test page
  (with-browser (b "website")
    (expect-text b (by-css "h1") "A Language for Building Languages")
    (expect-attribute b (by-text "Try Substrate") "href" "#playground")
    (expect-attribute b (by-text "Compile the compiler!") "href" "#playground/compiler")
    (expect-text b (by-css ".panel .code") (include-text "../counter.sub"))
    (expect-count b (within (by-css ".panel .code") (by-text "component")) 1)
    (expect-attribute b (within (by-css ".panel .code") (by-text "component")) "class" "k")
    (expect-text b (by-css ".counter output") "0")
    (browser-click! b (by-role "button" "+"))
    (browser-click! b (by-role "button" "+"))
    (expect-text b (by-css ".counter output") "2")
    (browser-click! b (by-css ".counter .reset"))
    (expect-text b (by-css ".counter output") "0")
    (expect-missing b (by-css ".counter .reset"))
    (expect-count b (by-css ".feature") 4)
    (expect-count b (by-css ".feature .code") 4)
    (expect-count b (by-css "#faq details") 3)))

(test examples
  (with-browser (b "website")
    (browser-click! b (by-role "button" "Hello"))
    (expect-text b (by-css ".pg-state") "Ready")
    (ran b "Hello" "Hello, Substrate!\nfib 0 = 0\nfib 1 = 1\nfib 2 = 1\nfib 3 = 2\nfib 4 = 3\nfib 5 = 5\nfib 6 = 8\nfib 7 = 13\nfib 8 = 21\nfib 9 = 34\nfib 10 = 55\n")
    (expect-count b (by-text-containing "Compiled in") 1)
    (ran b "Variants" "point: 3, 4\nareas: 9, 42\nabove 4: 2, above 8: 1\n")
    (ran b "Macros" "x * 2 + y / 5 = 10\n(x + y) * (y - x) = 84\n")
    (ran b "JSON" "substrate 0.10.1 has 2 tags\n{\"name\":\"substrate\",\"version\":\"1.0.0\",\"tags\":[\"lisp\",\"wasm\"]}\n")
    (ran b "Memory" "malloc: 7\narena: 1000 999 998\nbuffer: grows as needed\n")
    (ran b "Bend 2" "(S (S (S Z)))\n")))

(test compiler
  (with-browser (b "website")
    (browser-click! b (by-text "Compile the compiler!"))
    (expect-attribute b (by-role "button" "Compile the compiler") "aria-pressed" "true")
    (expect-attribute b (by-css ".pg-input") "readonly" "")
    (expect-value b (by-css ".pg-input") (include-text "../examples/compiler.sub"))
    (browser-click! b (by-css ".pg-run"))
    (finished b)
    (expect-count b (by-text-containing " modules, ") 1)
    (expect-count b (by-text-containing "Done in") 1)))

(test editing
  (with-browser (b "website")
    (expect-attribute b (by-css ".pg-reset") "disabled" "")
    (rewrite b "(define (main) (printf \"~a\\n\" (* 6 7)))")
    (expect-text b (by-css ".pg-highlight") "(define (main) (printf \"~a\\n\" (* 6 7)))\n")
    (expect-no-attribute b (by-css ".pg-reset") "disabled")
    (browser-press! b "Control+Enter")
    (finished b)
    (output b "42\n")
    (browser-click! b (by-css ".pg-reset"))
    (expect-value b (by-css ".pg-input") (include-text "../examples/hello.sub"))
    (expect-attribute b (by-css ".pg-reset") "disabled" "")))

(test errors
  (with-browser (b "website")
    (rewrite b "(define (main) (nope))")
    (browser-click! b (by-css ".pg-run"))
    (failed-with b "unbound identifier nope")
    (rewrite b "(define (main) (printf \"started\\n\") (printf \"~a\\n\" (@ (slice (array-of i32 1 2 3)) 3)))")
    (browser-click! b (by-css ".pg-run"))
    (failed-with b "index 3 is out of range for length 3")
    (expect-count b (by-text-containing "started") 1)
    (rewrite b "(define (main) (while #t (begin)))")
    (browser-click! b (by-css ".pg-run"))
    (browser-click! b (by-css ".pg-stop"))
    (expect-text b (by-css ".pg-state") "Stopped")
    (browser-click! b (by-css ".pg-reset"))
    (browser-click! b (by-css ".pg-run"))
    (finished b)
    (expect-count b (by-text-containing "fib 10 = 55") 1)))

(test address
  (with-browser (b "website" #:url "#playground/json")
    (expect-attribute b (by-role "button" "JSON") "aria-pressed" "true")
    (browser-click! b (by-role "button" "Macros"))
    (expect-attribute b (by-role "button" "Macros") "aria-pressed" "true")
    (expect-value b (by-css ".pg-input") (include-text "../examples/macros.sub"))))

(define served website)
(define local (array string 1) (array-of string ".localhost"))

(define (announced [s (ptr http-server)])
  (let ([line (make-buffer)])
    (buffer-add-string! (& line) "http://127.0.0.1:")
    (http-add-decimal! (& line) (cast i64 (-> s port)))
    (buffer-add-string! (& line) "/\n")
    (host-write 1 (buffer-bytes (& line)))))

(define (site-server)
  (website-init! (& served) (@ (host-args) 0) (slice local) "")
  (set! (-> served server listening) announced)
  (let ([why error])
    (unless (http-serve! (& (-> served server)) 0 website-handle (& why)) (host-exit 1 (error-text (& why))))))

(test served #:grants ((net "127.0.0.1"))
  (with-browser (b "website" #:server site-server)
    (ran b "Hello" "Hello, Substrate!\nfib 0 = 0\nfib 1 = 1\nfib 2 = 1\nfib 3 = 2\nfib 4 = 3\nfib 5 = 5\nfib 6 = 8\nfib 7 = 13\nfib 8 = 21\nfib 9 = 34\nfib 10 = 55\n")
    (expect-equal (browser-console b) "")))
