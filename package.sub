(package website
  (version "0.1.0")
  (substrate "0.12.0")
  (dependencies (snake (url "https://github.com/substrate-lang/snake-game/archive/refs/tags/v0.12.0.tar.gz")
                       (hash "sha256:d42ed31b01371221bb43aeb564272bda08f27ec593261724fee0665e24057c87"))
                (web-ui (url "https://github.com/substrate-lang/web-ui/archive/refs/tags/v0.12.0.tar.gz")
                        (hash "sha256:51f1067956c3b65e68ed26af4529f0d14cd89fbf5c43181b69fe5f32eb76c1b9"))
                (sqlite-explorer (url "https://github.com/substrate-lang/sqlite-explorer/archive/refs/tags/v0.12.0.tar.gz")
                                 (hash "sha256:7adbc041fbc323dc83fffca8a542514ba575c9a7d993863ec83df5e99a47fb74"))
                (bend2 (url "https://github.com/substrate-lang/substrate-bend2/archive/refs/tags/v0.12.0.tar.gz")
                       (hash "sha256:c845622dca4f4cd6da53a6eadeea84cf24b21aa4b4eacb7abac24fdf97d53609")))
  (programs (serve "serve.sub"))
  (sites (website "site.sub" (html "index.html")
                  (files "/src/substrate/compiler" (from compiler) "*.sub")
                  (files "/src/substrate/host" (from host) "**/*.sub")
                  (files "/src/std" (from std) "encoding/json.sub" "encoding/utf8.sub" "meta/derive.sub"
                         "meta/type-info.sub" "string.sub")
                  (files "/src/bend2" (from bend2) "*.sub")
                  (files "/src" "session.map")
                  (mount "/sqlite-explorer/" explorer))
         (explorer "explorer.sub" (html "explorer.html")))
  (tests "tests/code.sub" "tests/server.sub" "tests/browser.sub")
  (dev-dependencies (chromium)))
