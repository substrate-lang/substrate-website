                       (hash "sha256:83d27048c3b29608a6d0490464c9d7f250e24df4f92de1578a6ea5a515fac048"))
                (web-ui (url "https://github.com/substrate-lang/web-ui/archive/refs/tags/v0.11.3.tar.gz")
