(package website
  (version "0.1.0")
  (substrate "0.13.0")
  (dependencies (snake (url "https://github.com/substrate-lang/snake-game/archive/refs/tags/v0.13.0.tar.gz")
                       (hash "sha256:a93bdbe5ed89f4f19a13714e228d52a255c892858d2328b866026b6065a75155"))
                (web-ui (url "https://github.com/substrate-lang/web-ui/archive/refs/tags/v0.13.0.tar.gz")
                        (hash "sha256:d6e48adebcee50950fdb97c94915283c6d99129aa5c556a22ae4528bf26d5c12"))
                (sqlite-explorer (url "https://github.com/substrate-lang/sqlite-explorer/archive/refs/tags/v0.13.0.tar.gz")
                                 (hash "sha256:95a4c330d4100394dbd24a43600e89d145df982fa7fd24c68e5e4d2978e80a28"))
                (bend2 (url "https://github.com/substrate-lang/substrate-bend2/archive/refs/tags/v0.13.0.tar.gz")
                       (hash "sha256:ebdc501f83e6ac50a757288f9d70cb2e62ac146f57559750025d1e2b7d2dca72")))
  (programs (serve "serve.sub"))
  (sites (website "site.sub" (html "index.html")
                  (files "/src/substrate/compiler" (from compiler) "*.sub")
                  (files "/src/substrate/host" (from host) "**/*.sub")
                  (files "/src/std" (from std) "encoding/json.sub" "encoding/utf8.sub" "meta/derive.sub" "meta/generic.sub"
                         "meta/method.sub" "meta/type-info.sub" "string.sub" "vector/vector.sub")
                  (files "/src/bend2" (from bend2) "*.sub")
                  (files "/src" "session.map")
                  (mount "/sqlite-explorer/" explorer))
         (explorer "explorer.sub" (html "explorer.html")))
  (tests "tests/code.sub" "tests/server.sub" "tests/browser.sub")
  (dev-dependencies (chromium)))
