(package website
  (version "0.1.0")
  (substrate "0.11.0")
  (dependencies (snake (path "../snake-game"))
                (web-ui (url "https://github.com/substrate-lang/web-ui/archive/refs/tags/v0.11.0.tar.gz")
                        (hash "sha256:18eb5f01852d5e6664137cdd6dee898be733d2da3b55df177101cf4eb669ca88"))
                (bend2 (url "https://github.com/substrate-lang/substrate-bend2/archive/refs/tags/v0.11.0.tar.gz")
                       (hash "sha256:15d07c4ff74c44ed3aacafd5535cda6bd6a71b1579f49be7a9909e14e99d51e1")))
  (tests (browser))
  (sites (website "site.sub" (html "index.html")
                  (files "/src/substrate/compiler" (from compiler) "*.sub")
                  (files "/src/substrate/host" (from host) "**/*.sub")
                  (files "/src/std" (from std) "encoding/json.sub" "encoding/utf8.sub" "meta/derive.sub"
                         "meta/type-info.sub")
                  (files "/src/bend2" (from bend2) "*.sub")
                  (files "/src" "session.map"))))
