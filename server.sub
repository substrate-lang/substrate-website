;; The site's server: the site's files for the hosts allowed, with security headers and a redirect from www.HOST to
;; HOST. Files whose paths hold a hash, as substrate build --release writes them, are cached for a year. A path under
;; /sqlite-explorer/ that names no file is answered with the explorer's page, as the explorer's routes read it. The
;; site's page and the explorer's page come rendered (app-render), and the server keeps the last 64 pages it rendered
;; for targets without a query. serve.sub runs the server.
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/static)
(require-unqualified std/http/checks)
(require-unqualified std/http/routable)
(require-unqualified std/string)
(require-unqualified web-ui)
(require explorer-routes sqlite-explorer/routes)
(require explorer sqlite-explorer/explorer)
(require site "site.sub")

(provide website website-init! website-handle website-policy)

(define website-policy string
  "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'")

(const kept-most u32 64)

(struct kept-page [target string] [html string])

(struct website [server http-server] [files http-files] [hosts http-hosts] [security http-security]
  [checks (array http-check 2)] [apps (array http-app 1)] [pages (array http-page 2)] [canonical string]
  [kept (array kept-page 64)] [next u32])

(define (kept-html [w (ptr website)] [target string]) -> string
  (for ([i u32 0]) (< i kept-most) (+= i 1)
    (let ([k (& (@ (-> w kept) i))]) (when (and (> (-> k target length) 0) (== (-> k target) target)) (return (-> k html)))))
  "")

(define (kept! [w (ptr website)] [target string] [html string])
  (let ([k (& (@ (-> w kept) (-> w next)))])
    (unless (== (-> k target length) 0)
      (free (-> k target bytes))
      (free (-> k html bytes)))
    (set! (-> k target) (string-copy target))
    (set! (-> k html) (string-copy html))
    (set! (-> w next) (% (+ (-> w next) 1) kept-most))))

;; The page that app renders for r, or the one the server kept for r's target.
(define (kept-render [app (ptr web-app)] [r (ptr http-request)] [out (ptr buffer)] [page string] [mount string]
                     [to (ptr buffer)]) -> u32
  (let* ([w (cast (ptr website) (-> (http-request-server r) user))] [kept (kept-html w (-> r target))])
    (if (> (-> kept length) 0)
        (begin
          (buffer-add-string! out kept)
          url-found)
        (let ([read (app-render app out page (-> r target) mount to)])
          (when (and (== read url-found) (> (-> out length) 0) (not (string-contains? (-> r target) "?")))
            (kept! w (-> r target) (buffer-string out)))
          read))))

(define (site-page [r (ptr http-request)] [out (ptr buffer)] [page string] [mount string] [to (ptr buffer)]) -> u32
  (kept-render (& site:website-app) r out page mount to))

(define (explorer-page [r (ptr http-request)] [out (ptr buffer)] [page string] [mount string] [to (ptr buffer)]) -> u32
  (kept-render (& explorer:explorer-app) r out page mount to))

(define (host-name [r (ptr http-request)]) -> string
  (let ([h (http-request-header r "host")]) (slice h 0 (string-index h #\:))))

(define (www? [w (ptr website)] [r (ptr http-request)]) -> bool
  (let ([name (host-name r)] [canonical (-> w canonical)])
    (and (> (-> canonical length) 0) (== (-> name length) (+ (-> canonical length) 4))
         (http-same? (slice name 0 4) "www.") (http-same? (slice name 4) canonical))))

(define (website-handle [r (ptr http-request)])
  (let ([w (cast (ptr website) (-> (http-request-server r) user))])
    (if (www? w r)
        (let ([to (make-buffer)])
          (buffer-add-string! (& to) (if (http-request-https? r) "https://" "http://"))
          (buffer-add-string! (& to) (-> w canonical))
          (buffer-add-string! (& to) (-> r target))
          (http-redirect! r 301 (buffer-string (& to)))
          (buffer-free! (& to)))
        (http-static! r (& (-> w files))))))

(define (website-init! [w (ptr website)] [root string] [names (slice string)] [canonical string])
  (memset w 0 (sizeof website))
  (set! (-> w files root) root)
  (set! (@ (-> w apps) 0)
        (http-app #:path "/sqlite-explorer/" #:page "sqlite-explorer/index.html" #:routes explorer-routes:place.url-check))
  (set! (-> w files apps) (slice (-> w apps)))
  (set! (@ (-> w pages) 0) (http-page #:path "index.html" #:render site-page))
  (set! (@ (-> w pages) 1) (http-page #:path "sqlite-explorer/index.html" #:render explorer-page))
  (set! (-> w files pages) (slice (-> w pages)))
  (set! (-> w files cache) http-hashed-cache)
  (set! (-> w hosts names) names)
  (set! (-> w hosts addresses) #t)
  (set! (-> w security policy) website-policy)
  (set! (-> w canonical) canonical)
  (set! (-> (& (@ (-> w checks) 0)) run) http-hosts-check)
  (set! (-> (& (@ (-> w checks) 0)) settings) (cast (ptr void) (& (-> w hosts))))
  (set! (-> (& (@ (-> w checks) 1)) run) http-security-check)
  (set! (-> (& (@ (-> w checks) 1)) settings) (cast (ptr void) (& (-> w security))))
  (set! (-> w server checks) (slice (-> w checks)))
  (set! (-> w server user) (cast (ptr void) w))
  (set! (-> w server handle) website-handle)
  (set! (-> w server compress) 6)
  (set! (-> w server most) 1024))
