;; The site's server: the site's files for the hosts allowed, with security headers and a redirect from www.HOST to
;; HOST. Files whose paths hold a hash, as substrate build --release writes them, are cached for a year. The site's apps
;; answer the paths that name no file under where they are mounted (apps). A page that an app renders comes with the
;; app rendered into it (app-render), and the server keeps the last 64 that it rendered for targets without a query.
;; serve.sub runs the server.
(require-unqualified host/fs)
(require-unqualified std/http)
(require-unqualified std/http/server)
(require-unqualified std/http/static)
(require-unqualified std/http/checks)
(require-unqualified std/http/url)
(require-unqualified std/http/routable)
(require-unqualified std/package/path)
(require-unqualified std/string)
(require-unqualified web-ui)
(require explorer sqlite-explorer/explorer)
(require site "site.sub")

(provide website website-init! website-handle website-policy)

(define website-policy string
  "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'")

;; The apps: where package.sub's sites put each one, and its page in the built site.
(struct served [mount string] [page string] [app (ptr web-app)])

(define apps (array served 2)
  (array-of served (served #:mount "/sqlite-explorer/" #:page "sqlite-explorer/index.html" #:app (& explorer:explorer-app))
                   (served #:mount "/" #:page "index.html" #:app (& site:website-app))))

(const kept-most u32 64)

(struct kept-page [target string] [html string])

(struct website [server http-server] [files http-files] [hosts http-hosts] [security http-security]
  [checks (array http-check 2)] [canonical string] [kept (array kept-page 64)] [next u32])

;; The app mounted at the longest path that target starts with.
(define (served-for [target string]) -> (ptr served)
  (let ([found (ptr served) 0])
    (for ([i u32 0]) (< i (-> (slice apps) length)) (+= i 1)
      (let ([s (& (@ apps i))])
        (when (and (string-prefix? target (-> s mount)) (or (== found 0) (> (-> s mount length) (-> found mount length))))
          (set! found s))))
    found))

;; Whether the request is for a file of the site, which goes out as it is: its path names a file, or has a part that
;; the files refuse.
(define (file-request? [w (ptr website)] [r (ptr http-request)]) -> bool
  (let* ([a (make-arena)] [path (url-unescape (& a) (url-path (-> r target)) #f)] [info fs-info] [found #f])
    (set! found (or (string-contains? path "/.")
                    (and (fs-stat (joined-path (-> w files root) path) (& info) 0) (== (-> info kind) fs-file))))
    (arena-free (& a))
    found))

(define (page-text [w (ptr website)] [path string]) -> string
  (let ([b (slice u8)])
    (if (fs-read-file (joined-path (-> w files root) path) (& b) 0) (cast string b) "")))

(define (kept-html [w (ptr website)] [target string]) -> string
  (for ([i u32 0]) (< i kept-most) (+= i 1)
    (let ([k (& (@ (-> w kept) i))]) (when (and (> (-> k target length) 0) (== (-> k target) target)) (return (-> k html)))))
  "")

(define (kept! [w (ptr website)] [target string] [html string])
  (let ([k (& (@ (-> w kept) (-> w next)))])
    (unless (== (-> k target length) 0)
      (free (-> k target bytes))
      (free (-> k html bytes)))
    (set! (-> k target) (string-copy target))
    (set! (-> k html) (string-copy html))
    (set! (-> w next) (% (+ (-> w next) 1) kept-most))))

(define (page-sent! [r (ptr http-request)] [status u32] [html string])
  (http-respond! r status)
  (http-header! r "content-type" "text/html; charset=utf-8")
  (http-header! r "cache-control" "no-cache")
  (http-send-text! r html))

;; Answers r with the page of the app s: rendered, as built when the app does not render it, or the site's own answer
;; when the app has no page for it.
(define (app-answered! [w (ptr website)] [r (ptr http-request)] [s (ptr served)])
  (let ([kept (kept-html w (-> r target))] [page (page-text w (-> s page))])
    (cond [(> (-> kept length) 0) (page-sent! r 200 kept)]
          [(== (-> page length) 0) (http-static! r (& (-> w files)))]
          [else
           (let* ([out (make-buffer)] [to (make-buffer)]
                  [read (app-render (-> s app) (& out) page (-> r target) (-> s mount) (& to))])
             (cond [(== read url-moved) (http-redirect! r 301 (buffer-string (& to)))]
                   [(== read url-bad) (http-answer-text! r 400 "bad request")]
                   [(> (-> out length) 0)
                    (when (and (== read url-found) (not (string-contains? (-> r target) "?")))
                      (kept! w (-> r target) (buffer-string (& out))))
                    (page-sent! r (if (== read url-found) 200 404) (buffer-string (& out)))]
                   [(== read url-found) (http-send-file! r (& (-> w files)) (-> s page))]
                   [else (http-static! r (& (-> w files)))])
             (buffer-free! (& out))
             (buffer-free! (& to)))])
    (unless (== (-> page length) 0) (free (-> page bytes)))))

(define (host-name [r (ptr http-request)]) -> string
  (let ([h (http-request-header r "host")]) (slice h 0 (string-index h #\:))))

(define (www? [w (ptr website)] [r (ptr http-request)]) -> bool
  (let ([name (host-name r)] [canonical (-> w canonical)])
    (and (> (-> canonical length) 0) (== (-> name length) (+ (-> canonical length) 4))
         (http-same? (slice name 0 4) "www.") (http-same? (slice name 4) canonical))))

(define (website-handle [r (ptr http-request)])
  (let ([w (cast (ptr website) (-> (http-request-server r) user))] [s (served-for (-> r target))])
    (cond [(www? w r)
           (let ([to (make-buffer)])
             (buffer-add-string! (& to) (if (http-request-https? r) "https://" "http://"))
             (buffer-add-string! (& to) (-> w canonical))
             (buffer-add-string! (& to) (-> r target))
             (http-redirect! r 301 (buffer-string (& to)))
             (buffer-free! (& to)))]
          [(or (== s 0) (not (or (== (-> r method) "GET") (== (-> r method) "HEAD"))) (file-request? w r))
           (http-static! r (& (-> w files)))]
          [else (app-answered! w r s)])))

(define (website-init! [w (ptr website)] [root string] [names (slice string)] [canonical string])
  (memset w 0 (sizeof website))
  (set! (-> w files root) root)
  (set! (-> w files cache) http-hashed-cache)
  (set! (-> w hosts names) names)
  (set! (-> w hosts addresses) #t)
  (set! (-> w security policy) website-policy)
  (set! (-> w canonical) canonical)
  (set! (-> (& (@ (-> w checks) 0)) run) http-hosts-check)
  (set! (-> (& (@ (-> w checks) 0)) settings) (cast (ptr void) (& (-> w hosts))))
  (set! (-> (& (@ (-> w checks) 1)) run) http-security-check)
  (set! (-> (& (@ (-> w checks) 1)) settings) (cast (ptr void) (& (-> w security))))
  (set! (-> w server checks) (slice (-> w checks)))
  (set! (-> w server user) (cast (ptr void) w))
  (set! (-> w server handle) website-handle)
  (set! (-> w server compress) 6)
  (set! (-> w server most) 1024))
