;; substrate-lang.com: the sections of sections.sub, in the page's root element.
(require-unqualified web-ui)
(require-unqualified host/modules/timer)
(require-unqualified host/web/location)
(require-unqualified "sections.sub")

(struct site-state [unused u32])

(define (scroll-to-hash [source u32] [kind u32] [id u32] [tag (ptr void)] [value i32])
  (let ([url (location-get)])
    (for ([i u32 0]) (< i (-> url length)) (+= i 1)
      (when (== (@ url i) #\#)
        (let ([n (dom-element (slice url (+ i 1)))])
          (when (!= n 0) (dom-call! n "scrollIntoView")))
        (break)))
    (free (-> url bytes))))

(define (site-init [s (ptr site-state)]) (timer-after 0.0 (request! scroll-to-hash)))

(component (site)
  #:state [s site-state]
  #:init site-init
  #:style (include-text "site.css")
  (div ([class "site"])
    (site-header)
    (main
      (hero)
      (core-idea)
      (examples)
      (playground-section)
      (faq))
    (site-footer)))

(attach ["root" (site)])
